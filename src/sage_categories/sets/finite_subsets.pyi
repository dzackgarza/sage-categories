from sage_categories.cat.category import CategoryDeclaration as CategoryDeclaration
from sage_categories.sets.cardinals import CardinalObjectDeclaration as CardinalObjectDeclaration
from sage_categories.sets.category import Sets_FiniteSubsets_ElementType as Sets_FiniteSubsets_ElementType
from sage_categories.sets.category import Sets_FiniteSubsets_MorphismType as Sets_FiniteSubsets_MorphismType
from sage_categories.sets.category import Sets_FinitelySupportedFunctions_ElementType as Sets_FinitelySupportedFunctions_ElementType
from sage_categories.sets.category import Sets_FinitelySupportedFunctions_MorphismType as Sets_FinitelySupportedFunctions_MorphismType
from sage_categories.sets.elements import SetElementDeclaration as SetElementDeclaration
from sage_categories.sets.objects import SetObjectDeclaration as SetObjectDeclaration
from sage.misc.cachefunc import cached_method
from sage_categories.cat.category import Category as Category
from sage_categories.cat.properties import PropertySubcategory as PropertySubcategory
from sage_categories.kernel.decisions import Decision as Decision, Unknown as Unknown, UnknownClass as UnknownClass
from sage_categories.kernel.predicates import ask as ask, conjunction as conjunction, established as established
from sage_categories.kernel.refinement import refine as refine
from sage_categories.kernel.roles import ObjectOfCategory as ObjectOfCategory, Role as Role
from sage_categories.sets.cardinals import Cardinal as Cardinal, CardinalObject as CardinalObject
from sage_categories.sets.elements import Datum as Datum, SetElement as SetElement
from sage_categories.sets.exponentials import Function as Function
from sage_categories.sets.maps import Rule as Rule
from sage_categories.sets.objects import SetObject as SetObject

class FiniteSubsetsRole(SetObjectDeclaration):
    def base_set(self) -> SetObject: ...
    def subset_at(self, point: SetElement) -> SetObject: ...
    def point_of(self, subset: SetObject) -> SetElement: ...
    def index(self, subset: SetObject) -> CardinalObject: ...
    def __getitem__(self, position: CardinalObject | int) -> SetObject: ...

class SizedSubsetsRole(ObjectOfCategory):
    def subset_cardinality(self) -> CardinalObject: ...

class SizedSubsetsCategory(PropertySubcategory[[Rule], []]):
    def __init__(self, ambient: Category[[Rule], []], size: int) -> None: ...
    def size(self) -> CardinalObject: ...
    def __call__(self, base_set: SetObject) -> SetObject: ...

class FiniteSubsetsCategory(PropertySubcategory[[Rule], []]):
    @property
    def ObjectType(self) -> type[FiniteSubsetsRole]: ...
    @property
    def ElementType(self) -> type[Sets_FiniteSubsets_ElementType]: ...
    @property
    def MorphismType(self) -> type[Sets_FiniteSubsets_MorphismType]: ...
    def __init__(self, ambient: Category[[Rule], []]) -> None: ...
    @cached_method
    def __call__(self, base_set: SetObject) -> SetObject: ...
    @cached_method
    def of_size(self, size: int, base_set: SetObject) -> SetObject: ...
    def retained_size(self, subsets: SetObject) -> CardinalObject: ...
    @cached_method
    def subset_at(self, subsets: SetObject, point: SetElement) -> SetObject: ...
    def point_of(self, subsets: SetObject, subset: SetObject) -> SetElement: ...
    def index(self, subsets: SetObject, subset: SetObject) -> CardinalObject: ...
    def subset_at_position(self, subsets: SetObject, position: CardinalObject | int) -> SetObject: ...

class FinitelySupportedFunctionsRole(SetObjectDeclaration):
    def index_set(self) -> SetObject: ...
    def value_set(self) -> SetObject: ...
    def basepoint(self) -> SetElement: ...

class FinitelySupportedFunctionsCategory(PropertySubcategory[[Rule], []]):
    @property
    def ObjectType(self) -> type[FinitelySupportedFunctionsRole]: ...
    @property
    def ElementType(self) -> type[Sets_FinitelySupportedFunctions_ElementType]: ...
    @property
    def MorphismType(self) -> type[Sets_FinitelySupportedFunctions_MorphismType]: ...
    def __init__(self, ambient: Category[[Rule], []]) -> None: ...
    @cached_method
    def __call__(self, index_set: SetObject, basepoint: SetElement) -> SetObject: ...
    def retained_index_set(self, functions: SetObject) -> SetObject: ...
